{
  "name": "truenorth-mcp-tooling",
  "private": true,
  "description": "Repo-level dev tooling for TrueNorth-MCP. Not published. The distributed npm wrapper lives in npm/.",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:verify-gate-docs": "node scripts/lint-verify-gate-docs.js",
    "eval:methodology": "node scripts/run-methodology-evals.js",
    "eval:methodology:model": "node scripts/run-methodology-evals.js --mode model",
    "coverage": "node scripts/coverage.js run",
    "coverage:check": "node scripts/coverage.js check",
    "coverage:test": "node --test scripts/coverage.test.js",
    "preflight": "bash scripts/preflight.sh"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.12.0",
    "prettier": "3.9.10",
    "puppeteer": "25.15.0"
  },
  "version": "2.0.0"
}
