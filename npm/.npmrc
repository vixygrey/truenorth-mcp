# Publish config for the TrueNorth-MCP npm packages. This file carries no secret.
# The scope publishes to the public npm registry with public access. This documents
# the intent and backs the `--access public` flag in the release workflow.
#
# CAUTION: Never add an auth token (`//registry.npmjs.org/:_authToken=...`) to a
# committed .npmrc. A token grants publish rights. CI supplies the token through the
# NPM_TOKEN secret and NODE_AUTH_TOKEN, so no token belongs here.
@truenorth-mcp:registry=https://registry.npmjs.org/
access=public
