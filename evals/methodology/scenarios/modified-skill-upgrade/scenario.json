{
  "schema_version": 1,
  "id": "modified-skill-upgrade",
  "description": "Upgrade a clean workspace while preserving a committed local skill edit.",
  "modes": ["deterministic"],
  "fixture": "fixture",
  "driver": "run.js",
  "grader": "grade.js",
  "timeout_ms": 90000,
