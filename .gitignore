*~

# Environment
.env
.env.*
!.env.example

# Secrets — belt and braces alongside the gitleaks pre-commit hook
*.pem
*.key

# npm auth. Ignore every .npmrc so a token-bearing file cannot be committed by
# accident, then re-include the one safe, secret-free publish config in npm/.
.npmrc
!npm/.npmrc

# Logs
*.log

# Node
node_modules/

# Agent-tool local dirs. The `.agent/` workspace is tracked under version control
# (Requirement 1.13), so it is not ignored here.
.claude
.openhands

# The skill graph is a regenerable cache, rebuilt on demand by build_skill_graph.
# The rest of `.agent/` is tracked; only this cache file is ignored.
.agent/tasks/skill-graph.jsonl
