root = true

# Global defaults for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

# Rust specific overrides
[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

# Cargo configuration files
[Cargo.toml]
indent_style = space
indent_size = 4

# Markdown documentation
[*.md]
trim_trailing_whitespace = false
max_line_length = 80
